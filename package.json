{
  "name": "ptisintrinsic",
  "version": "0.1.0",
  "private": true,
  "description": "Discrete curvature, Laplacians, spectra and geodesic distance on triangle meshes, computed from edge lengths and checked against analytic answers and reference libraries.",
  "license": "Apache-2.0",
  "author": "PTisDEV",
  "homepage": "https://github.com/ptxxdxxd/PTisINTRINSIC#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptxxdxxd/PTisINTRINSIC.git"
  },
  "bugs": {
    "url": "https://github.com/ptxxdxxd/PTisINTRINSIC/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run docs:check && npm run build",
    "fixtures": "node scripts/export-fixtures.ts",
    "report": "node scripts/report.ts",
    "mutation": "python3 scripts/mutation/run.py",
    "docs:check": "node scripts/check-docs.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
